{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Skill",
      "Edit(./frontend/src/**/*.test.ts)",
      "Edit(./frontend/src/**/*.test.tsx)",
      "Edit(./frontend/src/test/**)",
      "Edit(./backend/tests/**)",
      "Edit(./.agent/**)",
      "Bash(node .claude/skills/run-unit-tests/scripts/tests.mjs *)",
      "Bash(node .claude/skills/pr-change-analysis/scripts/analyze-changes.mjs *)",
      "Bash(node .claude/skills/pr-change-analysis/scripts/search.mjs *)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Edit(./frontend/src/test/setup.ts)",
      "Edit(./frontend/src/design-system/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"", "timeout": 10 }]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_AUTOUPDATER": "1"
  }
}
